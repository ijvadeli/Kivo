{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kivo",
  "version": "0.1.1",
  "identifier": "com.idhva.kivo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kivo",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/192x192.png",
      "icons/512x512.png",
      "icons/apple-touch-icon.png",
      "icons/icon.ico"
    ]
  }
}
